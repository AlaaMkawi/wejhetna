{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "jsx": "react",
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "typeRoots": ["./node_modules/@types"],
    "types": []
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "Pods"]
}
